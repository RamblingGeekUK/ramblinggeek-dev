---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { Elgato } from 'simple-icons-astro'
const metadata = {
    title: 'RamblingGeek - What I Use',
    ignoreTitleTemplate: false,
  };

const props = Astro.props
---
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" {...props}>
	<path fill="currentColor" d="m13.882 8.396l.026.02l9.95 5.717a12.03 12.03 0 0 1-4.04 7.026A11.93 11.93 0 0 1 12.098 24a11.85 11.85 0 0 1-8.453-3.514A11.95 11.95 0 0 1 .143 12c0-3.204 1.244-6.219 3.501-8.485A11.85 11.85 0 0 1 12.097 0c2.44 0 4.785.733 6.783 2.119a12 12 0 0 1 4.628 6.308l-2.126 1.236a10 10 0 0 0-.262-.87c-1.354-3.83-4.98-6.405-9.023-6.405c-5.28 0-9.575 4.313-9.575 9.612s4.295 9.612 9.575 9.612a9.46 9.46 0 0 0 5.66-1.865a9.6 9.6 0 0 0 3.43-4.737l.007-.041L9.59 8.305v7.225l4-2.313l2.06 1.18l-5.996 3.47l-2.12-1.213v-9.46L9.652 5.97l4.231 2.428z" />
</svg>

<Layout metadata={metadata}>
    
    <Features2
        title="What I Use"
        subtitle="A collection of items that I use."
        items={[
        {
            title: 'PC - Custom Build',
            description: `
                <ul>
                    <li>AMD Ryzen 7 3700 8 Core 3.60Ghz</li>
                    <li>Corsair Vengeance RGB PRO 32</li>
                    <li>Samsung 970 EVO Plus 1TB</li>
                    <li>Samsung 860 EVO Pro 512GB</li>
                    <li>Nvidia 1660 Super</li>
                    <li>Corsair Carbide SPEC-06</li>
                    <li><a href="https://www.keychron.com/products/keychron-q6-qmk-custom-mechanical-keyboard-iso-layout-collection" target="_blank" rel="noopender">Keychron Q6 ISO</a></li>
                </ul>
                `,
            icon: 'fxemoji:desktopcomputer',
        },
        {
            title: 'Displays',
            description:
            `<ul>
                <li>Samsung 49” UltraWide Monitor</li>
                <li><a href="https://amzn.to/45PxkzW" target="_blank" rel="noopender">Ergotron HX - Arm</a></li>
                <li>2 x LG 27” 4k Monitors (desk/workbench)</li>
            </ui>`,
            icon: 'icon-park:monitor-one',
        },
        {
            title: 'Elgato',
            description:
            `<ul>
                <li><a href="https://amzn.to/42rjeBR" target="_blank" rel="noopener">3 x Elgato StreamDeck 32 Button</a></li>
                <li><a href="https://amzn.to/3WSJOTg" target="_blank" rel="noopender">Elgato StreamDeck+</a></li>
                <li><a href="https://amzn.to/3oWrX15" target="_blank" rel="noopender">Elgato Wave XLR</a></li>
                <li><a href="https://amzn.to/45TxC8K" target="_blank" rel="noopender">Elgato Keylights x 2</a></li>
                <li><a href="https://amzn.to/3oUNsPS" target="_blank" rel="noopender">Elgato 4K60 Pro MK.2</a></li>
                <li><a href="https://www.elgato.com/uk/en/p/wave-mic-arm" target="_blank" rel="noopender">Elgato Wave Mic Arm</a></li>
                <li><a href="" target="_blank" rel="noopender">Elgato Mic DX</a></li>
            </ul>`,
            icon:'Elgato',
        },
        {
            title: 'Furniture',
            description:
            `<ul>
                <li><a href="https://www.autonomous.ai/office-chairs/ergonomic-chair" target="_blank" rel="noopender">Autonomous Chair</a></li>
                <li><a href="https://amzn.to/3NeYsRF" target="_blank" rel="noopender">Standing Desk Frame</a></li>
            </ul>`,
            icon: 'icon-park:massage-chair-one',
        },
        {
            title: 'Camera Hardware',
            description:
            `<ul>
                <li><a href="https://amzn.to/3oS2rdr" target="_blank" rel="noopender">Sony A6400 Camera</a></li>
                <li><a href="https://amzn.to/3CdVyq2" target="_blank" rel="noopender">Sigma 16mm F1.4 DC DN Contemporary Sony E Lens</a></li>
                <li><a href="#" target="_blank" rel="noopender">3 x Logitech C920</a></li>
            </ul>`,
            icon: 'emojione:camera',
        }
        ]}
    >
  </Features2>
  
</Layout>